    <origin rpy="0.0 1.963496 0.0" xyz="0.5105 0.315 -0.129"/>
    <parent link="mobile_base"/>
    <child link="ultrasound_fl_sag_base_link"/>
  </joint>
  <link name="ultrasound_fl_sag_base_link"/>
